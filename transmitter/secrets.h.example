// Copy this file to secrets.h (local only, never commit it) and fill in
// your own values. The public transmitter sketch uses placeholders for
// these same values so it compiles only after you replace them.
//
// Example — DO NOT use these literal placeholder strings as real values:
//   WIFI_KEYWORD_1 / WIFI_KEYWORD_2: substrings of your hotspot SSID
//   WIFI_PASSWORD: your hotspot password
//   TG_BOT_TOKEN: your Telegram bot token from BotFather
//   TG_CHAT_ID: your Telegram chat/group ID
//   ALERT_LOCATION: e.g. "Home - Living Room" (your own label)
//   WEATHER_LAT / WEATHER_LON: your location coordinates as strings

#pragma once
constexpr const char* WIFI_KEYWORD1 = "YOUR_SSID_KEYWORD_1";
constexpr const char* WIFI_KEYWORD2 = "YOUR_SSID_KEYWORD_2";
constexpr const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";
constexpr const char* TG_BOT_TOKEN  = "YOUR_TELEGRAM_BOT_TOKEN";
constexpr const char* TG_CHAT_ID    = "YOUR_TELEGRAM_CHAT_ID";
constexpr const char* ALERT_LOCATION = "YOUR_LOCATION";
constexpr const char* WEATHER_LAT    = "YOUR_LATITUDE";
constexpr const char* WEATHER_LON    = "YOUR_LONGITUDE";
